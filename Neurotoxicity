from sklearn.metrics import confusion_matrix, classification_report, roc_auc_score, roc_curve
from sklearn.model_selection import cross_validate
​
# ---------------------- 1. 缺失值填充 ----------------------
imputer = SimpleImputer(strategy="median")
X_train_imp = imputer.fit_transform(X_train)
​
# ---------------------- 2. 特征标准化（SVM必须） ----------------------
scaler = StandardScaler()
X_train_scaled = scaler.fit_transform(X_train_imp)
​
# ---------------------- 3. SVC模型构建 ----------------------
clf = SVC(kernel='linear', class_weight='balanced', random_state=14, probability=True)
clf.fit(X_train_scaled, T_train.ravel())
​
# ---------------------- 4. 训练集预测与评估 ----------------------
T_pred = clf.predict(X_train_scaled)
print("===== 训练集混淆矩阵 =====")
print(confusion_matrix(T_train.ravel(), T_pred))
print("\n===== 训练集分类报告 =====")
print(classification_report(T_train.ravel(), T_pred, digits=4))
​
# ---------------------- 5. Linear-SVM 特征权重（修复X_train为numpy数组） ----------------------
coef = clf.coef_[0]
# 自动生成特征名称 feature_0, feature_1 ...
feature_names = [f"feature_{i}" for i in range(len(coef))]
feature_weight_df = pd.DataFrame({
    'feature': feature_names,
    'coef': coef,
    'abs_coef': np.abs(coef)
}).sort_values('abs_coef', ascending=False)
​
print("\n===== Top10 重要特征（SVM系数绝对值排序） =====")
print(feature_weight_df.head(10))
​
# ---------------------- 6. 10折交叉验证 ----------------------
cv = 10
